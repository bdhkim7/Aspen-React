    "test:e2e:ci": "cross-env CI=1 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001 start-server-and-test start:ci http://127.0.0.1:3001 \"playwright test\""
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1114.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
